# ===== 师承智导 项目环境变量配置 =====
# 复制此文件为 .env 并填入实际值
# 注意: .env 文件已加入 .gitignore，不会被提交到版本控制

# ===== 大模型 API（DeepSeek V4 Pro）=====
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=your_deepseek_api_key_here
LLM_API_MODEL=deepseek-chat
LLM_API_MODEL_PRO=deepseek-v4-pro

# ===== MySQL 数据库 =====
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# ===== 星火嵌入模型（讯飞 Embedding-v1，走 spark-server.js 代理签名）=====
# 启用方式：RAG_EMBEDDING_PROVIDER=spark（默认即 spark，失败自动回退本地哈希）
RAG_EMBEDDING_PROVIDER=spark
SPARK_APP_ID=your_spark_app_id
SPARK_API_KEY=your_spark_api_key
SPARK_API_SECRET=your_spark_api_secret
# 本地开发填 http://127.0.0.1:9876/embed；Docker 部署由 compose 自动注入 http://spark-embedding:9876/embed
SPARK_EMBEDDING_URL=http://127.0.0.1:9876/embed

# ===== 讯飞语音听写 (ASR) =====
# 控制台: https://console.xfyun.cn  服务: 语音听写
XFYUN_APPID=your_xfyun_app_id
XFYUN_API_KEY=your_xfyun_api_key
XFYUN_API_SECRET=your_xfyun_api_secret

# ===== MiMo TTS 语音克隆 =====
MIMO_TTS_API_KEY=your_mimo_tts_api_key
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
# 参考音频路径（可选；Docker 部署默认使用 /app/data/reference.wav）
TTS_REFERENCE_VOICE_PATH=

# ===== 知识库导入路径 =====
KNOWLEDGE_BASE_PATH=./data/knowledge-base
